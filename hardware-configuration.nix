# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, machineType ? "qemu", ... }:

let
  isQemu = machineType == "qemu";
  isBaremetal = machineType == "baremetal";
in

{
  imports = 
    if isQemu then
      [ (modulesPath + "/profiles/qemu-guest.nix") ]
    else
      [ (modulesPath + "/installer/scan/not-detected.nix") ];

  boot.initrd.availableKernelModules = 
    if isQemu then
      [ "ahci" "xhci_pci" "virtio_pci" "sr_mod" "virtio_blk" ]
    else
      [ "xhci_pci" "ahci" "nvme" "usb_storage" "usbhid" "sd_mod" "sr_mod" ]; 
 
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

# fileSystems."/tmp" =
#   { device = "/dev/disk/by-uuid/2af9c009-cd0e-4d9f-9319-e33e20ba2962";
#     fsType = "btrfs";
#   };

  fileSystems."/" =
    { device = 
        if isQemu then
          "/dev/disk/by-uuid/6b6700e6-e806-4cf9-bdb3-4896318ae444"
        else
          "/dev/disk/by-uuid/d325e226-2824-4d85-a4f9-5e6af3697699";
      fsType = "btrfs";
      options = [ "subvol=@" ];
    };

  fileSystems."/home" =
    { device = 
        if isQemu then
          "/dev/disk/by-uuid/6b6700e6-e806-4cf9-bdb3-4896318ae444"
        else
          "/dev/disk/by-uuid/d325e226-2824-4d85-a4f9-5e6af3697699";
      fsType = "btrfs";
      options = [ "subvol=@home" ];
    };

  # 実機のみ：/nix を独立サブボリュームにマウント
  fileSystems."/nix" = lib.mkIf isBaremetal
    { device = "/dev/disk/by-uuid/d325e226-2824-4d85-a4f9-5e6af3697699";
      fsType = "btrfs";
      options = [ "subvol=@nix" ];
    };

  fileSystems."/boot" =
    { device = 
        if isQemu then
          "/dev/disk/by-uuid/C08A-5289"
        else
          "/dev/disk/by-uuid/8280-0A6A";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  
  hardware.cpu.intel.updateMicrocode = 
    if isBaremetal then
      lib.mkDefault config.hardware.enableRedistributableFirmware
    else
      false;
}
